generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Client {
  id         String   @id
  name       String
  logo       String
  websiteUrl String?
  category   String?  @default("Global Partners")
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime
}

model Equipment {
  id        String   @id
  name      String
  count     Int      @default(1)
  img       String
  category  String?  @default("Heavy Equipment")
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime
}

model Gallery {
  id          String   @id
  title       String?
  img         String
  description String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime
}

model Project {
  id                   String   @id
  title                String
  img                  String
  serviceId            String
  createdAt            DateTime @default(now())
  updatedAt            DateTime
  client               String?
  consultant           String?
  description          String?
  duration             String?
  floors               String?
  foundationDepth      String?
  highlightDescription String?
  highlightImg         String?
  highlightTitle       String?
  highlights           String[] @default([])
  images               String[] @default([])
  keyAchievements      String[] @default([])
  location             String?
  order                Int      @default(0)
  owner                String?
  partnershipType      String?
  projectType          String?
  scope                String?
  slug                 String   @unique
  status               String?
  structuralDetails    String?
  structuralType       String?
  technicalSpecs       Json?
  totalArea            String?
  service              Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
}

model Section {
  id        String  @id
  title     String
  subtitle  String?
  type      String
  content   Json
  img       String?
  order     Int     @default(0)
  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
}

model Service {
  id          String    @id
  name        String
  slug        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime
  projects    Project[]
  sections    Section[]
}
